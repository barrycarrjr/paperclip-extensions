{
  "name": "paperclip-plugin-business-records",
  "version": "0.1.1",
  "description": "A record per business (statuses with their sources, standing documents, tax filings, linked cases) with the closure and filing rules enforced in code: a business cannot be marked dissolved, active or closed, and a filing cannot be marked filed, without a document on file to prove it.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "^2026.427.0"
  },
  "pnpm": {
    "overrides": {
      "@paperclipai/plugin-sdk": "file:../../vendor/sdk/plugin-sdk.tgz",
      "@paperclipai/shared": "file:../../vendor/sdk/shared.tgz"
    }
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "esbuild": "^0.27.3",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "license": "MIT",
  "author": "Barry Carr & Tony Allard"
}
