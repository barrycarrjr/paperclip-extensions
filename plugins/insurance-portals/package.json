{
  "name": "paperclip-plugin-insurance-portals",
  "version": "0.6.15",
  "description": "Paperclip plugin that signs in to insurance carrier portals (Foremost, Liberty Mutual, Selective) read-only and saves current policy and declarations-page PDFs to Google Drive.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "^2026.427.0",
    "imapflow": "^1.0.181",
    "mailparser": "^3.7.2",
    "pdfjs-dist": "4.10.38"
  },
  "pnpm": {
    "overrides": {
      "@paperclipai/plugin-sdk": "file:../../vendor/sdk/plugin-sdk.tgz",
      "@paperclipai/shared": "file:../../vendor/sdk/shared.tgz"
    }
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^24.6.0",
    "esbuild": "^0.27.3",
    "pdf-lib": "^1.17.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "license": "MIT",
  "author": "Bryon Stout",
  "packageManager": "pnpm@10.28.0"
}
